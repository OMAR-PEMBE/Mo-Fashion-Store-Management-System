APP_NAME="Mo Fashion Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# Install MySQL 8+. Port 3307 avoids XAMPP's MariaDB on 3306.
# Create the database/user using docs/LOCAL_SETUP.md, then set your password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mfbms
DB_USERNAME=mfbms_app
DB_PASSWORD=

# File sessions/cache allow the Phase 1 shell to boot before database setup.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database

# Customer messaging (config/messaging.php). "log" writes messages to the log instead of sending.
# Go live with WhatsApp: WHATSAPP_DRIVER=cloud plus the two values from Meta's WhatsApp Manager.
WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECEIPT_TEMPLATE=sale_receipt
WHATSAPP_RECEIPT_LANGUAGE=en
SMS_DRIVER=log
RECEIPT_LINK_DAYS=90
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail is written to the development log until a mail service is configured.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Database backups (Phase 24). Retention must be 7-30 days. Set full client paths
# when mysqldump/mysql are not on PATH, e.g. "C:/Program Files/MySQL/MySQL Server 9.6/bin/mysqldump.exe".
# Restore checks use <DB_DATABASE>_restore_check; see database/setup-local.sql.
BACKUP_RETENTION_DAYS=14
BACKUP_DAILY_AT=01:30
BACKUP_VERIFY_WEEKLY_AT=03:00
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_MYSQL_BINARY=mysql

# Production: APP_ENV=production, APP_DEBUG=false, HTTPS APP_URL,
# SESSION_SECURE_COOKIE=true, LOG_LEVEL=warning, restricted database account.
# Payment, WhatsApp, AI, object storage and production mail providers: TBD.
